{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "resolveJsonModule": true
  },
  "include": [
    "blume.config.ts",
    "islands/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
